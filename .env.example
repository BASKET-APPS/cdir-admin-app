# Copy to .env.local. Never commit private credentials.
# No environment file needed for the development-only local demo.
# Firebase SQL Connect (project cdir-apps):
CDIR_MODE=firebase
CDIR_DATABASE=sql-connect
SQL_CONNECT_SERVICE_ID=cdir-apps-2-service
SQL_CONNECT_LOCATION=europe-southwest1
FIREBASE_STORAGE_ENABLED=false
NEXT_PUBLIC_PROFILE_UPLOAD_ENABLED=false
APP_ORIGIN=http://127.0.0.1:3002
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Path outside the repository, or Application Default Credentials on the host.
GOOGLE_APPLICATION_CREDENTIALS=
# DATABASE_URL is only needed for the legacy direct PostgreSQL adapter, not SQL Connect.
# 32 random bytes in base64. Store in Secret Manager in production.
BANK_ENCRYPTION_KEY=
ADMIN_EMAIL=
# Must stay false until real registration workflow and privacy texts are approved.
PUBLIC_REGISTRATION_ENABLED=false

# One-time installation owner; remove after the first successful Google login.
BOOTSTRAP_ADMIN_EMAIL=

# Secret for a weekly production scheduler calling POST /api/jobs/retention.
RETENTION_JOB_SECRET=

# Base URL of the public website, used by published magazine links.
NEXT_PUBLIC_CDIR_PUBLIC_URL=https://basket-apps.github.io/front-cdir
