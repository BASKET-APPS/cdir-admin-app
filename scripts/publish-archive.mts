import {initializeApp,applicationDefault} from 'firebase-admin/app';
import {getDataConnect} from 'firebase-admin/data-connect';
import {readFile,mkdir,copyFile,writeFile} from 'node:fs/promises';
import {createHash,randomUUID} from 'node:crypto';
import {normalizeWorkspacePage,workspacePageQuery,workspaceMutation} from '../src/domain/sql-connect';
import {emptyState,type State} from '../src/domain/types';
const app=initializeApp({credential:applicationDefault(),projectId:'cdir-apps'}),dc=getDataConnect({serviceId:'cdir-apps-2-service',location:'europe-southwest1'},app),before=emptyState();let offset=0;
while(true){const page=normalizeWorkspacePage((await dc.executeGraphqlRead<Record<string,unknown>,undefined>(workspacePageQuery(offset))).data);for(const key of Object.keys(page) as (keyof State)[])(before[key] as unknown[]).push(...page[key]);if(!Object.values(page).some(rows=>rows.length===500))break;offset+=500;}
const next=structuredClone(before),urls=['https://cdir.es/wp-content/uploads/2022/03/Revista-CDIR-marzoabril-2022.pdf','https://cdir.es/wp-content/uploads/2022/05/Revista-CDIR-mayojunio-2022.pdf','https://cdir.es/wp-content/uploads/2022/11/Revista-CDIR-sepoct-2022.pdf','https://cdir.es/wp-content/uploads/2023/02/Revista-CDIR-No4.pdf'];
for(let i=1;i<=4;i++){const m=next.magazines.find(m=>m.title==='Revista CDIR nº '+i);if(m){m.pdfPath=urls[i-1];m.isExample=false;m.published=true;m.publishedAt||=new Date().toISOString();}}
await mkdir('public/archive',{recursive:true});
for(const [slug,file,title] of [['torneo-azua','asset-58.jpeg','Torneo Doctor Azúa 2026'],['torneo-gandia','asset-59.jpeg','Torneo Gandía 2026']]){await copyFile('../front-cdir/public/club/'+file,'public/archive/'+file);if(!next.contents.some(c=>c.title===title))next.contents.push({id:randomUUID(),kind:'DOCUMENT',title,body:'Cartel del archivo original del club. Edición celebrada durante la temporada 2025 / 2026.',url:'/archive/'+file,status:'DRAFT',seasonId:next.seasons.find(s=>s.name==='2025 / 2026')!.id});}
if(process.argv.includes('--with-sports-examples')){for(const name of ['Benjamín 2.º año femenino A','Cadete 2.º año masculino A']){const t=next.teams.find(t=>t.name===name&&next.seasons.find(s=>s.id===t.seasonId)?.current);if(!t)continue;const rows=next.matches.filter(m=>m.teamId===t.id&&m.isExample);const past=rows.filter(m=>m.status==='FINAL').sort((a,b)=>b.startsAt.localeCompare(a.startsAt))[0],future=rows.filter(m=>m.status==='SCHEDULED'&&new Date(m.startsAt)>new Date()).sort((a,b)=>a.startsAt.localeCompare(b.startsAt))[0];if(past)past.published=true;if(future)future.published=true;}for(const a of next.clubActivities.filter(a=>a.isExample))a.published=true;}
const version=(await dc.executeGraphqlRead<{workspaceRevision:{version:number}},undefined>('query R @auth(level: NO_ACCESS) {workspaceRevision(key: {id: "club"}) {version}}')).data.workspaceRevision.version;const mutation=workspaceMutation(before,next,version);if(mutation)await dc.executeGraphql(mutation.query,{variables:mutation.variables});console.log('Cuatro revistas originales disponibles en la web y carteles históricos añadidos como borradores.');
