{
  "name": "cdir-admin-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.cjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "db:local": "node --env-file-if-exists=.env.local --import tsx scripts/local-db.mts",
    "db:local:stop": "node --env-file-if-exists=.env.local scripts/local-db-stop.mjs",
    "db:schema": "node scripts/generate-sql-connect.mjs",
    "db:bootstrap:firebase": "node --env-file-if-exists=.env.local scripts/sql-connect-bootstrap.mjs",
    "test:sql-connect": "node --env-file-if-exists=.env.local --import tsx scripts/sql-connect-smoke.mts",
    "db:seed:club": "node --env-file-if-exists=.env.local --import tsx scripts/seed-club.mts --apply",
    "test:club-ui": "node scripts/club-ui-test.cjs",
    "cleanup:dry-run": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup-dry-run.mts",
    "measure:queries": "npx tsx scripts/measure-queries.mts",
    "validate:scoped": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/validate-scoped-readonly.mts",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
